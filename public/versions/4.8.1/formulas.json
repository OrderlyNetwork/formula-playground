        "factorType": {
          "baseType": "number",
          "nullable": false,
          "array": false
        },
        "description": "Calculated order fee."
      }
    ],
    "formulaText": "{\n  const orderValue = order.price * order.qty;\n  const feeRate = order.isMaker ? 0.0002 : 0.0005; // Maker: 0.02%, Taker: 0.05%\n  return orderValue * feeRate;\n}",
    "sourceCode": "export function calculateOrderFee(order: {\n  price: number;\n  qty: number;\n  isMaker: boolean;\n}): number {\n  const orderValue = order.price * order.qty;\n  const feeRate = order.isMaker ? 0.0002 : 0.0005; // Maker: 0.02%, Taker: 0.05%\n  return orderValue * feeRate;\n}",
