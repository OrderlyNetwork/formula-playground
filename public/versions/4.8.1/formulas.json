  {
    "id": "percentage_change",
    "name": "Percentage Change",
    "version": "1.0.0",
    "description": "Calculates the percentage change between two values.",
    "tags": [
      "utility",
      "percentage"
    ],
    "inputs": [
      {
        "key": "oldValue",
        "type": "number",
        "factorType": {
          "baseType": "number",
          "constraints": {},
          "nullable": false,
          "array": false
        }
      },
      {
        "key": "newValue",
        "type": "number",
        "factorType": {
          "baseType": "number",
          "constraints": {},
          "nullable": false,
          "array": false
        }
      }
    ],
    "outputs": [
      {
        "key": "result",
        "type": "number",
        "factorType": {
          "baseType": "number",
          "nullable": false,
          "array": false
        },
        "description": "The percentage change."
      }
    ],
    "formulaText": "{\n  if (oldValue === 0) {\n    return 0;\n  }\n  return ((newValue - oldValue) / oldValue) * 100;\n}",
    "sourceCode": "export function calculatePercentageChange(\n  oldValue: number,\n  newValue: number\n): number {\n  if (oldValue === 0) {\n    return 0;\n  }\n  return ((newValue - oldValue) / oldValue) * 100;\n}",
