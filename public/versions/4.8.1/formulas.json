                      "array": false
                    }
                  }
                ]
              }
            },
            {
              "key": "newOrder",
              "type": "object",
              "factorType": {
                "baseType": "object",
                "nullable": false,
                "array": false,
                "properties": [
                  {
                    "key": "symbol",
                    "type": "string",
                    "factorType": {
                      "baseType": "string",
                      "nullable": false,
                      "array": false
                    }
                  },
                  {
                    "key": "qty",
                    "type": "number",
                    "factorType": {
                      "baseType": "number",
                      "nullable": false,
                      "array": false
                    }
                  },
                  {
                    "key": "price",
                    "type": "number",
                    "factorType": {
                      "baseType": "number",
                      "nullable": false,
                      "array": false
                    }
                  }
                ]
              }
            }
          ]
        }
