[
  {
    "id": "liquidation_price",
    "name": "Liquidation Price Calculation",
    "version": "1.0.0",
    "description": "Calculates the liquidation price for a leveraged position.",
    "tags": [
      "perpetual",
      "risk",
      "liquidation"
    ],
    "inputs": [
      {
        "key": "entryPrice",
        "type": "number",
        "factorType": {
          "baseType": "number",
          "constraints": {},
          "nullable": false,
          "array": false
        }
      },
      {
        "key": "leverage",
        "type": "number",
        "factorType": {
          "baseType": "number",
          "constraints": {},
          "nullable": false,
          "array": false
        }
      },
      {
        "key": "isLong",
        "type": "boolean",
        "factorType": {
          "baseType": "boolean",
          "constraints": {},
          "nullable": false,
          "array": false
        }
      },
      {
        "key": "maintenanceMarginRate",
        "type": "number",
        "factorType": {
          "baseType": "number",
          "constraints": {},
          "nullable": false,
          "array": false
        },
        "default": "0.005"
      }
    ],
    "outputs": [
      {
        "key": "result",
        "type": "number",
        "factorType": {
          "baseType": "number",
          "nullable": false,
          "array": false
        },
        "description": "The calculated liquidation price."
      }
    ],
    "formulaText": "{\n  const marginRate = 1 / leverage;\n\n  if (isLong) {\n    // Long position liquidation price\n    return entryPrice * (1 - marginRate + maintenanceMarginRate);\n  } else {\n    // Short position liquidation price\n    return entryPrice * (1 + marginRate - maintenanceMarginRate);\n  }\n}",
    "sourceCode": "export function calculateLiquidationPrice(\n  entryPrice: number,\n  leverage: number,\n  isLong: boolean,\n  maintenanceMarginRate: number = 0.005\n): number {\n  const marginRate = 1 / leverage;\n\n  if (isLong) {\n    // Long position liquidation price\n    return entryPrice * (1 - marginRate + maintenanceMarginRate);\n  } else {\n    // Short position liquidation price\n    return entryPrice * (1 + marginRate - maintenanceMarginRate);\n  }\n}",
    "localNpmInfo": {
      "packageName": "formula-playground",
      "functionName": "calculateLiquidationPrice",
      "enabled": true
    }
  },
  {
    "id": "pnl_calculation",
    "name": "Profit and Loss Calculation",
    "version": "1.1.0",
    "description": "Calculates the profit or loss for a trading position.",
    "tags": [
      "trading",
      "pnl",
      "financial"
    ],
    "inputs": [
      {
        "key": "entryPrice",
        "type": "number",
        "factorType": {
          "baseType": "number",
          "constraints": {},
          "nullable": false,
          "array": false
        }
      },
      {
        "key": "exitPrice",
        "type": "number",
        "factorType": {
          "baseType": "number",
          "constraints": {},
          "nullable": false,
          "array": false
        }
      },
      {
        "key": "quantity",
        "type": "number",
        "factorType": {
          "baseType": "number",
          "constraints": {},
          "nullable": false,
          "array": false
        }
      },
      {
        "key": "isLong",
        "type": "boolean",
        "factorType": {
          "baseType": "boolean",
          "constraints": {},
          "nullable": false,
          "array": false
        }
      }
    ],
    "outputs": [
      {
        "key": "result",
        "type": "number",
        "factorType": {
          "baseType": "number",
          "nullable": false,
          "array": false
        },
        "description": "The calculated profit or loss."
      }
    ],
    "formulaText": "{\n  if (isLong) {\n    return (exitPrice - entryPrice) * quantity;\n  } else {\n    return (entryPrice - exitPrice) * quantity;\n  }\n}",
    "sourceCode": "export function calculatePnL(\n  entryPrice: number,\n  exitPrice: number,\n  quantity: number,\n  isLong: boolean\n): number {\n  if (isLong) {\n    return (exitPrice - entryPrice) * quantity;\n  } else {\n    return (entryPrice - exitPrice) * quantity;\n  }\n}",
    "localNpmInfo": {
      "packageName": "formula-playground",
      "functionName": "calculatePnL",
      "enabled": true
    }
  },
