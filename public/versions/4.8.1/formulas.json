  {
    "id": "order_fee",
    "name": "Order Fee",
    "version": "1.0.0",
    "description": "Calculate order fee from an object payload.",
    "tags": [
      "order",
      "fee"
    ],
    "inputs": [
      {
        "key": "order",
        "type": "object",
        "factorType": {
          "baseType": "object",
          "constraints": {},
          "nullable": false,
          "array": false,
          "properties": [
            {
              "key": "price",
              "type": "number",
              "factorType": {
                "baseType": "number",
                "nullable": false,
                "array": false
              }
            },
            {
              "key": "qty",
              "type": "number",
              "factorType": {
                "baseType": "number",
                "nullable": false,
                "array": false
              }
            },
            {
              "key": "isMaker",
              "type": "boolean",
              "factorType": {
                "baseType": "boolean",
                "nullable": false,
                "array": false
              }
            }
          ]
        }
      }
    ],
    "outputs": [
      {
        "key": "result",
